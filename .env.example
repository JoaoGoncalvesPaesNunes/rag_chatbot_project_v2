TOP_K=6
DATA_DIR=data
RAW_PDFS_DIR=data/raw_pdfs
PROCESSED_DIR=data/processed
VECTOR_STORE_DIR=data/vector_store
LOGS_DIR=logs
RESEARCH_LOGS_DIR=research_logs
SQLITE_DB_NAME=research_data.sqlite
DEFAULT_PROMPT_PROFILE=academico_formal
DEEPSEEK_TIMEOUT=60
